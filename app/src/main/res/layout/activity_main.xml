<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout android:id="@+id/header" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:layout_marginTop="18dp" android:layout_marginEnd="16dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROJECT ZENITH"
                android:textColor="#101828" android:textSize="25sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="CONTROL CENTER  /  READY" android:textColor="#667085" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
        </LinearLayout>
        <ImageView android:id="@+id/btnThemeToggle" android:layout_width="42dp" android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:padding="10dp"
            android:contentDescription="Toggle theme" app:tint="#101828" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/mainScrollView" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginTop="15dp" android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/header">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="110dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your device. Your rules." android:textColor="#101828" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Apply focused tweaks without root." android:textColor="#667085" android:textSize="13sp" />

            <HorizontalScrollView android:id="@+id/chipScrollView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupCategories" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipSpacingHorizontal="7dp" app:singleSelection="true" app:selectionRequired="true">
                    <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="ALL" app:checkedIconVisible="false" app:chipCornerRadius="10dp" app:chipStrokeWidth="0dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipPerformance" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERFORMANCE" app:checkedIconVisible="false" app:chipCornerRadius="10dp" app:chipStrokeWidth="0dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipDisplay" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DISPLAY" app:checkedIconVisible="false" app:chipCornerRadius="10dp" app:chipStrokeWidth="0dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipNetwork" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK" app:checkedIconVisible="false" app:chipCornerRadius="10dp" app:chipStrokeWidth="0dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipGaming" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GAMING" app:checkedIconVisible="false" app:chipCornerRadius="10dp" app:chipStrokeWidth="0dp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardDeviceInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="18dp" app:cardBackgroundColor="#12233F" app:cardCornerRadius="27dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvDeviceModel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEVICE CHECKING" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvAndroidVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/android_version_checking" android:textColor="#9CCBFF" android:textSize="12sp" />
                        </LinearLayout>
                        <com.google.android.material.card.MaterialCardView android:id="@+id/cardShizukuStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#1B6A55" app:cardCornerRadius="25dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                            <TextView android:id="@+id/tvShizukuStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:text="Shizuku" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="19dp" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RAM" android:textColor="#8EA1BD" android:textSize="10sp" android:textStyle="bold" /><TextView android:id="@+id/tvRamUsage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="-- GB" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" /><com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/pbRam" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:max="100" app:indicatorColor="#62D6B0" app:trackColor="#335C6D89" app:trackCornerRadius="4dp" app:trackThickness="4dp" /></LinearLayout>
                        <Space android:layout_width="12dp" android:layout_height="1dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STORAGE" android:textColor="#8EA1BD" android:textSize="10sp" android:textStyle="bold" /><TextView android:id="@+id/tvStorageUsage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="-- GB" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" /><com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/pbStorage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:max="100" app:indicatorColor="#62D6B0" app:trackColor="#335C6D89" app:trackCornerRadius="4dp" app:trackThickness="4dp" /></LinearLayout>
                        <Space android:layout_width="12dp" android:layout_height="1dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BATTERY" android:textColor="#8EA1BD" android:textSize="10sp" android:textStyle="bold" /><TextView android:id="@+id/tvBattery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="--%" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" /><com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/pbBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:max="100" app:indicatorColor="#F5C451" app:trackColor="#335C6D89" app:trackCornerRadius="4dp" app:trackThickness="4dp" /></LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="API" android:textColor="#8EA1BD" android:textSize="10sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DISPLAY" android:textColor="#8EA1BD" android:textSize="10sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FREE SPACE" android:textColor="#8EA1BD" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/tvApiLevel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" /><TextView android:id="@+id/tvResolutionDisplay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" /><TextView android:id="@+id/tvFreeStorageDisplay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" /></LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CONTROL MODULES" android:textColor="#101828" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.05" /><TextView android:id="@+id/tvActiveSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#E6ECF2" android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:text="0 of 22 active" android:textColor="#667085" android:textSize="11sp" android:textStyle="bold" /></LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" android:text="Tap a module to configure it. Reset actions stay local." android:textColor="#667085" android:textSize="12sp" />

            <!-- The module cards intentionally use the same IDs as the original UI so feature behavior remains intact. -->
            <androidx.cardview.widget.CardView android:id="@+id/cardFixedPerformance" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="CORE  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Fixed performance" /><TextView style="@style/ZenithControlDescription" android:text="Lock performance to a consistent state." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusFixedPerf" style="@style/ZenithStatus" android:text="Status: Default" /><TextView android:id="@+id/btnResetFixedPerf" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardOptimizeSystem" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="SYSTEM  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Optimize system" /><TextView style="@style/ZenithControlDescription" android:text="Prioritize the active application." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusOptimize" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetOptimize" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardGamePresets" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="GAMING  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Game presets" /><TextView style="@style/ZenithControlDescription" android:text="Save a focused profile for each game." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusGamePresets" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetGamePresets" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardImproveNetwork" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="NETWORK  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Network focus" /><TextView style="@style/ZenithControlDescription" android:text="Tune network behavior for play." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusNetwork" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetNetwork" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardImproveTouch" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="INPUT  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Touch response" /><TextView style="@style/ZenithControlDescription" android:text="Reduce touch delay and improve feel." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusTouch" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetTouch" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardAdjustRefreshRate" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="DISPLAY  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Refresh rate" /><TextView style="@style/ZenithControlDescription" android:text="Choose a display refresh profile." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusRefresh" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetRefresh" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardFastAnimations" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="DISPLAY  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Fast animations" /><TextView style="@style/ZenithControlDescription" android:text="Make system transitions feel snappier." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusAnimations" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetAnimations" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardDisableBlurs" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="DISPLAY  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Disable blur" /><TextView style="@style/ZenithControlDescription" android:text="Reduce visual effects for a lighter interface." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusBlurs" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetBlurs" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardGamingDnd" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="GAMING  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Gaming focus" /><TextView style="@style/ZenithControlDescription" android:text="Keep interruptions out while you play." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusDnd" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetDnd" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardDisableDevOptions" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="SYSTEM  /  FREE" /><TextView style="@style/ZenithControlTitle" android:text="Developer options" /><TextView style="@style/ZenithControlDescription" android:text="Restore the developer settings switch." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusDevOptions" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetDevOptions" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardFstrim" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="STORAGE  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Storage trim" /><TextView style="@style/ZenithControlDescription" android:text="Refresh storage performance." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusFstrim" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetFstrim" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardRamBooster" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="MEMORY  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Memory boost" /><TextView style="@style/ZenithControlDescription" android:text="Prepare memory for a demanding session." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusRamBooster" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetRamBooster" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardClearCache" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="STORAGE  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Clear app caches" /><TextView style="@style/ZenithControlDescription" android:text="Free temporary space before a session." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusCache" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetCache" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardFreezeApps" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="SYSTEM  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Freeze background apps" /><TextView style="@style/ZenithControlDescription" android:text="Keep selected apps from consuming resources." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusFreeze" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetFreeze" style="@style/ZenithReset" android:text="RESTORE" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardChangeResolution" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="DISPLAY  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Resolution profile" /><TextView style="@style/ZenithControlDescription" android:text="Use a custom resolution and density profile." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusResolution" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetResolution" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardCustomDns" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="NETWORK  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Private DNS" /><TextView style="@style/ZenithControlDescription" android:text="Choose a private DNS profile." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusDns" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetDns" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardCrosshair" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="AIM  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Crosshair overlay" /><TextView style="@style/ZenithControlDescription" android:text="Configure a lightweight on-screen reticle." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusCrosshair" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetCrosshair" style="@style/ZenithReset" android:text="STOP" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardRealtimeMonitor" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="TELEMETRY  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Live monitor" /><TextView style="@style/ZenithControlDescription" android:text="Watch system telemetry while a game runs." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusMonitor" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetMonitor" style="@style/ZenithReset" android:text="STOP" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardAutoClick" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="INPUT  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Auto click" /><TextView style="@style/ZenithControlDescription" android:text="Configure an on-screen input helper." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusAutoClick" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetAutoClick" style="@style/ZenithReset" android:text="STOP" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardGameMode" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="GAMING  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Game mode" /><TextView style="@style/ZenithControlDescription" android:text="Set a system game mode for a selected title." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusGameMode" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetGameMode" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardAdaptiveGaming" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="GAMING  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Adaptive gaming" /><TextView style="@style/ZenithControlDescription" android:text="Adjust the profile as conditions change." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusAdaptive" style="@style/ZenithStatus" android:text="Status: Default" /><TextView android:id="@+id/btnResetAdaptive" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardThermalThrottling" style="@style/ZenithControlCard"><LinearLayout style="@style/ZenithControlContent"><TextView style="@style/ZenithControlEyebrow" android:text="THERMAL  /  PREMIUM" /><TextView style="@style/ZenithControlTitle" android:text="Thermal control" /><TextView style="@style/ZenithControlDescription" android:text="Review thermal behavior before changing it." /><LinearLayout style="@style/ZenithControlFooter"><TextView android:id="@+id/tvStatusThermal" style="@style/ZenithStatus" android:text="Status: Ready" /><TextView android:id="@+id/btnResetThermal" style="@style/ZenithReset" android:text="RESET" /></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
